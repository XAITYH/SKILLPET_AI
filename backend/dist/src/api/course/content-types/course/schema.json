{
    "kind": "collectionType",
    "collectionName": "courses",
    "info": {
        "singularName": "course",
        "pluralName": "courses",
        "displayName": "Course",
        "description": "Learning courses available in the app"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "title": {
            "type": "string",
            "required": true
        },
        "description": {
            "type": "text"
        },
        "slug": {
            "type": "uid",
            "targetField": "title"
        },
        "level": {
            "type": "enumeration",
            "required": true,
            "default": "beginner",
            "enum": [
                "beginner",
                "intermediate",
                "advanced"
            ]
        },
        "banner": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images"
            ]
        },
        "order": {
            "type": "integer",
            "default": 0
        },
        "chapters": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::chapter.chapter",
            "mappedBy": "course"
        },
        "length": {
            "type": "integer",
            "required": true
        }
    }
}
